# ─── Database ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── Better Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="your-32-char-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ─── MinIO (S3-compatible image storage) ──────────────────────────────────────
# Docs: https://min.io/docs/minio/linux/developers/javascript/API.html
MINIO_ENDPOINT="http://localhost:9000"        # MinIO server API endpoint
MINIO_REGION="us-east-1"                       # any region; MinIO ignores it
MINIO_ACCESS_KEY="your-minio-access-key"
MINIO_SECRET_KEY="your-minio-secret-key"
MINIO_BUCKET="sadrax"
# Public base URL for serving objects (include the bucket for path-style access)
MINIO_PUBLIC_URL="http://localhost:9000/sadrax"

# ─── Upstash Redis (OTP rate limiting) ────────────────────────────────────────
# Docs: https://upstash.com/docs/redis/overall/getstarted
UPSTASH_REDIS_REST_URL="https://xxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ─── MSG91 (phone OTP + SMS) ──────────────────────────────────────────────────
# Docs: https://docs.msg91.com/
MSG91_AUTH_KEY="your-msg91-auth-key"
MSG91_TEMPLATE_ID="your-otp-template-id"

# ─── Gmail SMTP (email OTP) ───────────────────────────────────────────────────
# Use an App Password (not your account password)
# Enable at: https://myaccount.google.com/apppasswords  (requires 2FA)
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# ─── Razorpay (payments) ──────────────────────────────────────────────────────
# Docs: https://razorpay.com/docs/
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# ─── App config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="Sadrax Grocery"
NEXT_PUBLIC_STORE_PHONE="9876543210"
NEXT_PUBLIC_STORE_ADDRESS="Sadras, Kalpakam, Tamil Nadu — 603102"
NEXT_PUBLIC_STORE_EMAIL="support@sadrax.in"
NEXT_PUBLIC_FSSAI_NUMBER=""
NEXT_PUBLIC_GST_NUMBER=""

# Free delivery threshold in paise (₹1 = 100 paise). Default: ₹200
NEXT_PUBLIC_FREE_DELIVERY_THRESHOLD="20000"

# Delivery fee in paise. Default: ₹29
NEXT_PUBLIC_DELIVERY_FEE="2900"

# ─── Admin setup (one-time use) ───────────────────────────────────────────────
# POST /api/admin/setup to create the first admin account.
# CLEAR THIS after first use in production.
ADMIN_SETUP_SECRET="change-this-to-a-strong-secret"

# ─── PostHog analytics ────────────────────────────────────────────────────────
# Get key from: https://app.posthog.com → Project Settings → API Keys
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ─── Telegram bot (new order notifications) ───────────────────────────────────
# 1. Open @BotFather in Telegram → /newbot → copy token
# 2. Send a message to your bot, then open: https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy your chat_id from the response
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ─── Sentry error monitoring ──────────────────────────────────────────────────
# Get DSN from: https://sentry.io → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ─── Web Push (VAPID keys for PWA notifications) ───────────────────────────────
# Generate with: node -e "const wp = require('web-push'); const k = wp.generateVAPIDKeys(); console.log('PUBLIC:', k.publicKey, '\nPRIVATE:', k.privateKey)"
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:support@sadrax.in"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
